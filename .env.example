# ==============================================================================
# Nirai E-Commerce - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure these variables in your deployment dashboard
# (Vercel, Netlify, Cloudflare Pages, Supabase, etc.).
# NEVER commit real secret values, keys, or passwords to version control.
# ==============================================================================

# Supabase BaaS (Database, Real-time Subscriptions, and BaaS REST API)
# Obtain from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-supabase-anon-key

# Cloudinary (Media Library & Product Image Uploads)
# Obtain from: Cloudinary Console > Settings > Upload > Upload presets (Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Error Monitoring (Sentry - Optional)
# Obtain from: Sentry Project Settings > Client Keys (DSN)
# If empty, Sentry remains uninitialized and inactive.
VITE_SENTRY_DSN=https://your-dsn-key@o0.ingest.sentry.io/0

# Application Canonical URL (Used for SEO, sitemaps, payment links, and transactional emails)
APP_URL=http://localhost:3000

# ==============================================================================
# Supabase Edge Functions & Transactional Notifications (Phase 4B)
# ==============================================================================
# Resend API Key: Obtain from https://resend.com/api-keys
# In Edge Function secrets: supabase secrets set RESEND_API_KEY=re_...
RESEND_API_KEY=re_your_resend_api_key

# Configurable Sender Email (Requirement A)
# In production (requires domain verification): "Nirai Handlooms <orders@nirai.in>"
# In development / sandbox (without domain verification): "Nirai Handlooms <onboarding@resend.dev>"
NOTIFY_FROM_EMAIL="Nirai Handlooms <onboarding@resend.dev>"

# Webhook Secret Header: Authenticates database webhooks & dispatch calls (Requirement C)
# In Edge Function secrets: supabase secrets set NOTIFY_WEBHOOK_SECRET=your_secure_secret
NOTIFY_WEBHOOK_SECRET=your_secure_webhook_secret_here

# Cron Secret Header: Authenticates scheduled Edge Function cron jobs (expire-unpaid-orders)
CRON_SECRET=your_secure_cron_secret_here
