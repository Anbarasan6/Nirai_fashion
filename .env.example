# ==============================================================================
# Nirai E-Commerce - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure these variables in your deployment dashboard
# (Vercel, Netlify, Cloudflare Pages, Supabase, etc.).
# NEVER commit real secret values, keys, or passwords to version control.
# ==============================================================================

# Supabase BaaS (Database, Real-time Subscriptions, and BaaS REST API)
# Obtain from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-supabase-anon-key

# Cloudinary (Media Library & Product Image Uploads)
# Obtain from: Cloudinary Console > Settings > Upload > Upload presets (Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Application Canonical URL (Used for SEO, sitemaps, and redirects)
APP_URL=http://localhost:3000
